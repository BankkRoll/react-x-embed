{
  "name": "react-x-embed",
  "version": "4.0.0",
  "repository": "https://github.com/BankkRoll/react-x-embed.git",
  "author": "BankkRoll (https://github.com/BankkRoll)",
  "scripts": {
    "build": "pnpm build:swc && pnpm types",
    "build:swc": "swc src -d dist --copy-files",
    "dev": "pnpm build:swc -w",
    "types": "tsc --emitDeclarationOnly",
    "lint": "TIMING=1 eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "test": "tsx --tsconfig ./test/tsconfig.json --import ./test/css-module-loader-register.mjs --test test/*.test.ts",
    "clean": "rm -rf dist && rm -rf .turbo"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BankkRoll/react-x-embed/issues"
  },
  "sideEffects": [
    "./dist/twitter-theme/tweet-container.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "react-server": "./dist/index.js",
      "default": "./dist/index.client.js"
    },
    "./api": "./dist/api/index.js",
    "./theme.css": "./dist/twitter-theme/theme.css"
  },
  "files": [
    "dist/**/*.{js,d.ts,css}"
  ],
  "typesVersions": {
    "*": {
      "index": [
        "src/index"
      ],
      "utils": [
        "src/utils"
      ],
      "api": [
        "src/api/index"
      ],
      "*": []
    }
  },
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "index": [
          "dist/index.d.ts"
        ],
        "utils": [
          "dist/utils.d.ts"
        ],
        "api": [
          "dist/api/index.d.ts"
        ],
        "*": []
      }
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.3",
    "clsx": "^2.0.0",
    "swr": "^2.2.4"
  },
  "devDependencies": {
    "@swc/cli": "^0.1.63",
    "@swc/core": "^1.3.100",
    "@types/node": "20.10.5",
    "@types/react": "^18.2.45",
    "chokidar": "^3.5.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  },
  "description": "Embed X (Twitter) posts in React — link previews, responsive media, and payload validation. No API key required.",
  "homepage": "https://github.com/BankkRoll/react-x-embed",
  "keywords": [
    "react",
    "x",
    "twitter",
    "tweet",
    "embed",
    "post",
    "rsc",
    "server-components",
    "oembed",
    "syndication"
  ]
}
